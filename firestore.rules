rules_version = '2';

// FIRESTORE SECURITY RULES — PRD §39, §67.
//
// Ownership model: a document under users/{userId} is readable and writable
// ONLY by the authenticated user whose uid equals {userId}. The uid is taken
// from the verified auth token (request.auth.uid), never from client-supplied
// data, so a user can never reach another user's expenses, receipts, pockets
// or profile.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Basic shape validation so a compromised client cannot write garbage
    // that would break the analytics engines.
    function validExpense() {
      let d = request.resource.data;
      return d.amount is number
        && d.amount >= 0
        && d.date is string
        && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.category is string
        && d.userId == request.auth.uid;
    }

    function validPocket() {
      let d = request.resource.data;
      return d.target is number
        && d.target >= 0
        && d.monthlyContribution is number
        && d.monthlyContribution >= 0
        && d.name is string
        && d.name.size() > 0
        && d.userId == request.auth.uid;
    }

    // User profile document
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Expenses
      match /expenses/{expenseId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validExpense();
      }

      // Savings pockets
      match /pockets/{pocketId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validPocket();
      }

      // Receipt extraction metadata
      match /receipts/{receiptId} {
        allow read, write: if isOwner(userId);
      }

      // Settings (salary, DPS rate, currency, onboarding state)
      match /settings/{docId} {
        allow read, write: if isOwner(userId);
      }

      // Any future nested collection inherits the same ownership model.
      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
